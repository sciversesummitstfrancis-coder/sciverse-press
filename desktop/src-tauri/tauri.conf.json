{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sciverse Press",
  "version": "1.0.5",
  "identifier": "com.sciverse.press",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sciverse Press",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QjhBOEFFREU2QzEwNjgKUldSb0VHemVycWk0V2V6Y0lhVkVXY3UvQlVnMTQ2Rmc4cHdWNXJ5Z09GdG44SDRaL3AxVkNtYVIK",
      "endpoints": [
        "https://github.com/sciversesummitstfrancis-coder/sciverse-press/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
